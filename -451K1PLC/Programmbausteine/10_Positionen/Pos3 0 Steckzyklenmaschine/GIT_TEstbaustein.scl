FUNCTION "GIT_TEstbaustein" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      IN_1 : Bool;
      IN_2 : Bool;
   END_VAR

   VAR_OUTPUT 
      OUT_1 : Bool;
   END_VAR


BEGIN
	IF #IN_1 THEN
	    #OUT_1 := true;
	END_IF;
	
	
	IF #IN_2 THEN
	    #OUT_1 := false;
	END_IF;
	
END_FUNCTION

